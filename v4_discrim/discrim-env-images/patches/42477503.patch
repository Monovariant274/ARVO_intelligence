+vips_case( VipsImage *index, VipsImage **cases, VipsImage **out, int n, ... )
+{
+	va_list ap;
+	int result;
+
+	va_start( ap, n );
+	result = vips_casev( index, cases, out, n, ap );
+	va_end( ap );
+
+	return( result );
+}
