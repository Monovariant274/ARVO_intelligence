+static int
+vips_casev( VipsImage *index, VipsImage **cases, VipsImage **out, int n,
+	va_list ap )
+{
+	VipsArrayImage *array;
+	int result;
+
+	array = vips_array_image_new( cases, n );
+	result = vips_call_split( "case", ap, index, array, out );
+	vips_area_unref( VIPS_AREA( array ) );
+
+	return( result );
+}
+
