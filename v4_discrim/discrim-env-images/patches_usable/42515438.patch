+QString createTimeTag(time_t time, const char *tag)
+{
+    auto value = QDateTime::fromSecsSinceEpoch(time, Qt::UTC);
+    if (value.isValid() && time > 0) {
+        return createTag(value.toString(Qt::ISODate), tag);
+    }
+    return QString();
+}
